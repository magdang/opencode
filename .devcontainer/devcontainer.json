{
  "name": "OpenCode (Bun 1.3)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": ["--network=host"]
  },
  "remoteUser": "bun",
  "updateRemoteUserUID": false,
  "runArgs": ["--network=host"],
  "postCreateCommand": "bun install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
